# Copy this file to .env and replace the placeholders.
# Never commit your real .env file or share these secrets.

PORT=10000
NODE_ENV=development
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/ububiko_smart?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h

# Extra browser origins allowed by CORS, separated by commas. The deployed app
# and its Vercel/Netlify preview deployments are always allowed by default.
# Wildcards are supported, e.g. https://your-project-*.vercel.app or https://*.vercel.app
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
